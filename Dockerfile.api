# Node.js API Server Dockerfile
FROM oven/bun:1-alpine AS base
WORKDIR /app

# Install dependencies from server/package.json (not root)
FROM base AS install
RUN mkdir -p /temp/dev
COPY server/package.json server/bun.lock /temp/dev/
RUN cd /temp/dev && bun install --frozen-lockfile

# Prisma client + prismabox generation stage (node for speed/reliability)
FROM node:26-alpine AS prisma
WORKDIR /app
COPY --from=install /temp/dev/node_modules node_modules
COPY server/ ./server/
COPY shared/ ./shared/
COPY server/prisma/ ./server/prisma/
RUN npx --no-install prisma generate --schema=server/prisma/schema.prisma

# Runtime stage
FROM base AS runtime
ENV NODE_ENV=production

# Copy server node_modules built from server/package.json
COPY --from=install /temp/dev/node_modules node_modules

# Copy server source and shared types
COPY server/ ./server/
COPY shared/ ./shared/

# Copy Prisma schema for migrations
COPY server/prisma/ ./server/prisma/

# Copy freshly generated Prisma client + prismabox types
COPY --from=prisma /app/node_modules/.prisma node_modules/.prisma
COPY --from=prisma /app/node_modules/@prisma/client node_modules/@prisma/client
COPY --from=prisma /app/server/generated ./server/generated

# Expose port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=5 \
  CMD wget -qO- http://localhost:3000/health || exit 1

# Start application
CMD ["bun", "run", "server/src/index.ts"]
