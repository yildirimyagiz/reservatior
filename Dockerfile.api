# Node.js API Server Dockerfile
FROM oven/bun:1-alpine AS base
WORKDIR /app

# Install dependencies
FROM base AS install
RUN mkdir -p /temp/dev
COPY package.json bun.lock /temp/dev/
RUN cd /temp/dev && bun install

# Runtime stage
FROM base AS runtime
ENV NODE_ENV=production
COPY --from=install /temp/dev/node_modules node_modules
COPY . .

# Copy the pre-generated Prisma client (locally generated on Mac with Linux binaries)
COPY server/prisma-generated/.prisma node_modules/.prisma
COPY server/prisma-generated/@prisma node_modules/@prisma

# Build application (Skipped: Bun executes TS natively, and tsc causes OOM on VPS)
# RUN bun run build

# Expose port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:3000/health || exit 1

# Start application
CMD ["bun", "run", "server/src/index.ts"]
