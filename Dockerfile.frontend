# Stage 1: Install dependencies
FROM oven/bun:1-alpine AS deps
WORKDIR /app
# Kopyalama sırası ve path'leri local path yapısına uygun olarak ayarlayalım
COPY shared/types ./shared/types
COPY client-seo/package.json client-seo/bun.lock* ./client-seo/
WORKDIR /app/client-seo
RUN bun install --frozen-lockfile

# Stage 2: Build Next.js app
FROM oven/bun:1-alpine AS builder
WORKDIR /app
COPY --from=deps /app/shared/types ./shared/types
COPY --from=deps /app/client-seo/node_modules ./client-seo/node_modules
COPY client-seo/ ./client-seo/
WORKDIR /app/client-seo
ARG BACKEND_INTERNAL_URL=http://localhost:3000
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production
ENV BACKEND_INTERNAL_URL=$BACKEND_INTERNAL_URL
RUN bun run build

# Stage 3: Production runner
FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

COPY --from=builder /app/client-seo/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/client-seo/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/client-seo/.next/static ./.next/static

USER nextjs

EXPOSE 3001
ENV PORT=3001
ENV HOSTNAME="0.0.0.0"

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD node -e "require('http').get('http://localhost:3001/', (r) => process.exit(r.statusCode >= 200 && r.statusCode < 400 ? 0 : 1)).on('error', () => process.exit(1))"

CMD ["node", "server.js"]
