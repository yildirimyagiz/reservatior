{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "types": [
      "bun-types",
      "node"
    ],
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@server/*": [
        "../server/src/*"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "allowJs": true,
    "incremental": true,
    "esModuleInterop": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "src/app",
    "src/components",
    "src/lib",
    "src/hooks",
    "src/i18n",
    "src/locales",
    "src/types",
    "src/config",
    "src/pages-spa"
  ],
  "exclude": [
    "node_modules",
    "src/router",
    "src-original"
  ]
}
