{
  "function_declarations": [
    {
      "name": "property_search",
      "description": "Search for properties in the Reservatior database based on location, budget, and other criteria",
      "parameters": {
        "type": "object",
        "properties": {
          "location": {
            "type": "string",
            "description": "City, district, or neighborhood name (e.g., 'Kadıköy', 'Beşiktaş', 'Şişli')"
          },
          "price_max": {
            "type": "number",
            "description": "Maximum budget in local currency (e.g., 50000)"
          },
          "price_min": {
            "type": "number",
            "description": "Minimum budget in local currency (e.g., 10000)"
          },
          "rooms": {
            "type": "string",
            "description": "Room configuration (e.g., '1+1', '2+1', '3+1')"
          },
          "property_type": {
            "type": "string",
            "enum": ["apartment", "house", "villa", "studio"],
            "description": "Type of property"
          },
          "furnished": {
            "type": "boolean",
            "description": "Whether the property is furnished"
          },
          "limit": {
            "type": "integer",
            "description": "Maximum number of results to return (default: 10, max: 50)",
            "default": 10
          }
        },
        "required": ["location"]
      }
    },
    {
      "name": "get_nearby_amenities",
      "description": "Get information about nearby amenities for a specific property (parks, schools, metro stations, hospitals, shopping centers)",
      "parameters": {
        "type": "object",
        "properties": {
          "property_id": {
            "type": "string",
            "description": "Unique property identifier"
          },
          "radius": {
            "type": "number",
            "description": "Search radius in kilometers (default: 2)",
            "default": 2
          },
          "amenity_type": {
            "type": "string",
            "enum": ["park", "school", "metro", "hospital", "shopping", "all"],
            "description": "Filter by amenity type (default: all)",
            "default": "all"
          }
        },
        "required": ["property_id"]
      }
    }
  ],
  "tool_config": {
    "function_calling_config": {
      "mode": "AUTO"
    }
  }
}
