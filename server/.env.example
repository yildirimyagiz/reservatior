# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/elysia_realestate"

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET="change-me-min-32-chars-in-production-generate-with-openssl"
JWT_REFRESH_SECRET="change-me-refresh-secret-different-from-access-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# ── Encryption (for API key / secret fields in DB) ────────────────────────────
# Generate with: openssl rand -base64 32
APP_SECRET="change-me-in-production-min-32-chars-for-aes-256"

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins, or * for all
CORS_ORIGIN="http://localhost:3000,http://localhost:5173"

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_API=200          # requests per minute for standard API
RATE_LIMIT_READ=500         # requests per minute for read-heavy endpoints

# ── Cache ─────────────────────────────────────────────────────────────────────
CACHE_MAX_KEYS=2000         # max LRU entries in memory

# ── Storage (S3-compatible) ───────────────────────────────────────────────────
STORAGE_BUCKET="elysia-files"
STORAGE_REGION="us-east-1"
STORAGE_ENDPOINT="https://s3.us-east-1.amazonaws.com"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
CDN_BASE_URL=""             # Optional: CloudFront / Cloudflare CDN base URL

# ── Super-admins (comma-separated user IDs) ───────────────────────────────────
SUPER_ADMIN_USER_IDS=""
