  agentAssignments               AgentAssignment[]
  agentPerformance               AgentPerformance[]
  agentTeams                     AgentTeam[]
  teamMemberships                AgentTeamMember[]               @relation("UserTeamMemberships")
  analytics                      Analytics[]
  apiKeys                        ApiKey[]
  apiTokens                      ApiToken[]
  appointments                   Appointment[]
  auditLogs                      AuditLog[]
