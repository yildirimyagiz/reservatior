  posts                          Post[]
  managedProjects                Project[]                       @relation("ProjectManager")
  propertyCompliance             PropertyCompliance[]
  ownershipTransfersFrom         PropertyOwnershipTransfer[]     @relation("OwnershipTransfersFrom")
  ownershipTransfersTo           PropertyOwnershipTransfer[]     @relation("OwnershipTransfersTo")
