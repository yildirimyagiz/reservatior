model AnalysisJob {
  id             String             @id @default(cuid())
  documentId     String
  orgId          String
  status         String             @default("QUEUED")
  type           String
  priority       String             @default("normal")
  startedAt      DateTime?
  completedAt    DateTime?
  processingTime Int?
  errorMessage   String?
  parameters     Json?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  document       Document           @relation("AnalysisJobDocument", fields: [documentId], references: [id])
  org            Organization       @relation(fields: [orgId], references: [id])
  analyses       DocumentAnalysis[]

  @@index([orgId])
  @@index([documentId])
  @@index([status])
  @@index([type])
  @@index([priority])
  @@index([createdAt])
}

model DocumentAnalysis {
  id             String        @id @default(cuid())
  documentId     String
  jobId          String?
  orgId          String?
  extractedText  String?
  metadata       Json?
  classification Json?
  confidence     Float?
  processingTime Int?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  document       Document      @relation(fields: [documentId], references: [id])
  job            AnalysisJob?  @relation(fields: [jobId], references: [id])
  org            Organization? @relation(fields: [orgId], references: [id])

  @@index([documentId])
  @@index([jobId])
  @@index([orgId])
  @@index([confidence])
}

model Role {
  id          String               @id @default(cuid())
  orgId       String
  key         MemberRoleKey
  name        String
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  deletedAt   DateTime?
  locationId  String?
  org         Organization         @relation(fields: [orgId], references: [id])
  permissions RolePermission[]
  members     OrganizationMember[]

  @@unique([orgId, key])
  @@index([orgId])
}

model Permission {
  id          String           @id @default(cuid())
  key         PermissionKey    @unique
  name        String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?
  roles       RolePermission[]
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])

  @@unique([roleId, permissionId])
}

model OrganizationMember {
  id        String       @id @default(cuid())
  userId    String
  orgId     String
  roleId    String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?
  user      User         @relation(fields: [userId], references: [id])
  org       Organization @relation(fields: [orgId], references: [id])
  role      Role         @relation(fields: [roleId], references: [id])

  @@unique([userId, orgId])
  @@index([orgId])
  @@index([roleId])
}

model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  name       String
  tokenHash  String    @unique
  scopes     String[]
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  user       User      @relation(fields: [userId], references: [id])

  @@index([userId])
}

