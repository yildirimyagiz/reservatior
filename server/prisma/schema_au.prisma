  calendarEvents                 CalendarEvent[]
  clientRelationships            ClientRelationship[]
  communicationLogs              CommunicationLog[]
  dashboardConfigurations        DashboardConfiguration[]
  dashboardWidgets               DashboardWidget[]
  documents                      Document[]
  earnings                       Earning[]
  eventAttendees                 EventAttendee[]
  favorites                      Favorite[]
  governmentIntegrations         GovernmentIntegration[]
  hashtags                       Hashtag[]
  investorPortfolio              InvestorPortfolio?
  languages                      Language[]
  leads                          Lead[]
  leadConversions                LeadConversion[]                @relation("UserLeadConversions")
  loyaltyAccounts                LoyaltyAccount[]
  maintenanceAssigned            MaintenanceWorkOrder[]          @relation("MaintenanceAssignedTo")
  workOrdersReported             MaintenanceWorkOrder[]
  mentionsByUser                 Mention[]                       @relation("MentionsByUser")
  mentionsToUser                 Mention[]                       @relation("MentionsToUser")
  mentionsAsGeneric              Mention[]                       @relation("MentionsGenericUser")
  mobileDevices                  MobileDevice[]
  notifications                  Notification[]
  offers                         Offer[]
  offlineSyncQueues              OfflineSyncQueue[]
  reviewedOwnershipDocuments     OwnershipVerificationDocument[] @relation("ReviewedOwnershipDocuments")
