  maxAmountPerMonth Decimal       @db.Decimal(14, 2) // Maksimum çekilebilecek ceza/kira limiti
  currency          String        @default("TRY")
  validUntil        DateTime
  lastUsedAt        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  tenant Tenant       @relation(fields: [tenantId], references: [id])
  lease  Lease?       @relation(fields: [leaseId], references: [id])
  org    Organization @relation(fields: [orgId], references: [id])

  @@index([orgId])
  @@index([tenantId])
  @@index([status])
}

model IotAccessLog {
  id            String     @id @default(cuid())
  orgId         String
  smartLockId   String
  leaseId       String?
  action        LockAction // LOCK, UNLOCK, SUSPEND, RESTORE
  triggerSource String // SYSTEM_VRP_FAIL, MANUAL, TENANT_APP
  status        String // SUCCESS, FAILED
  reason        String? // "VRP tahsilatı yapılamadı, EVICTION_PENDING devreye girdi"
  createdAt     DateTime   @default(now())

  smartLock SmartLock    @relation(fields: [smartLockId], references: [id])
  lease     Lease?       @relation(fields: [leaseId], references: [id])
  org       Organization @relation(fields: [orgId], references: [id])

  @@index([smartLockId])
  @@index([leaseId])
}

model GuestVerification {
  id        String  @id @default(cuid())
  orgId     String
  contactId String // Guest/Contact ID
  bookingId String? // Associated booking

  // Verification stages
  currentStage   VerificationStage @default(QUICK_START)
  stageProgress  Json // { quick_start: true, verified_guest: false, ... 
  organization   Organization?     @relation(fields: [organizationId], references: [id])
  organizationId String?
  contact        Contact           @relation(fields: [contactId], references: [id])
  booking        Booking?          @relation(fields: [bookingId], references: [id])
}

model TenantVerificationStage {
  id        String @id @default(cuid())
  orgId     String
  contactId String

  stage  VerificationStage
  status VerificationStatus @default(PENDING)

  requiredCriteria  Json // ["email_verification", "phone_verification"]
  completedCriteria Json // ["email_verification", "phone_verification"]

  timeToComplete String? // "2 minutes", "5 minutes"
  startedAt      DateTime?
  completedAt    DateTime?

  conversionGate Boolean @default(false) // If true, user cannot proceed without completing

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org     Organization @relation(fields: [orgId], references: [id])
  contact Contact      @relation(fields: [contactId], references: [id])

  @@unique([contactId, stage])
  @@index([orgId])
  @@index([contactId])
  @@index([stage])
}

model SecurityIncident {
  id         String  @id @default(cuid())
  orgId      String
  propertyId String
  bookingId  String?
  contactId  String? // Guest involved

  incidentType SecurityIncidentType
  severity     SecurityIncidentSeverity @default(MEDIUM)
  status       SecurityIncidentStatus   @default(REPORTED)

  // Incident details
  description String
  location    String? // Where incident occurred
  reportedBy  String // Contact ID or system
  reportedAt  DateTime @default(now())

  // Investigation
  investigatedBy     String? // Admin user ID
  investigationNotes String?
  evidence           Json? // Array of document IDs, photos, etc.

  // Resolution
  resolvedAt      DateTime?
  resolutionNotes String?
  actionTaken     String? // "WARNING_ISSUED", "FINE_APPLIED", "BAN_ISSUED"

  // Impact
  propertyDamage Decimal? @db.Decimal(10, 2)
  fineAmount     Decimal? @db.Decimal(10, 2)
  fineCurrency   String   @default("USD")

  // Follow-up
  followUpRequired Boolean   @default(false)
  followUpDate     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org      Organization @relation(fields: [orgId], references: [id])
  property Property     @relation(fields: [propertyId], references: [id])
  booking  Booking?     @relation(fields: [bookingId], references: [id])
  contact  Contact?     @relation(fields: [contactId], references: [id])

  @@index([orgId])
  @@index([propertyId])
  @@index([bookingId])
  @@index([contactId])
  @@index([incidentType])
  @@index([severity])
  @@index([status])
  @@index([reportedAt])
}

model OperatorLicense {
  id            String @id @default(cuid())
  orgId         String
  operatorOrgId String // Property management company org ID

  licenseNumber    String @unique
  licenseType      String // "PROPERTY_MANAGEMENT", "HOSPITALITY", "SHORT_TERM_RENTAL"
  issuingAuthority String // Government body or certification agency

  // License details
  issuedAt  DateTime
  expiresAt DateTime
  status    OperatorLicenseStatus @default(PENDING)

  // Coverage
  serviceAreas  Json // Array of regions/cities
  maxProperties Int? // Maximum properties they can manage

  // Insurance requirements
  insuranceRequired  Boolean   @default(true)
  insuranceAmount    Decimal?  @db.Decimal(12, 2)
  insuranceProvider  String?
  insuranceExpiresAt DateTime?

  // Compliance
  backgroundCheckPassed Boolean? @default(false)
  complianceScore       Float? // 0-100

  // Verification
  verifiedBy String? // Admin user ID
  verifiedAt DateTime?
  documents  Json? // License document IDs

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org         Organization @relation(fields: [orgId], references: [id])
  operatorOrg Organization @relation("OperatorOrg", fields: [operatorOrgId], references: [id])

  @@index([orgId])
  @@index([operatorOrgId])
  @@index([licenseNumber])
  @@index([status])
  @@index([expiresAt])
}

model TenantReliabilityScore {
  id        String @id @default(cuid())
  orgId     String
  contactId String @unique

  // Overall score
  overallScore Float // 0-100
  tier         ReliabilityTier // BRONZE, SILVER, GOLD, PLATINUM

  // Category scores
  identityScore   Float // 0-100
  financialScore  Float // 0-100
  behavioralScore Float // 0-100
  socialScore     Float // 0-100

  // Score history
  previousScore Float?
  scoreChange   Float? // Positive = improvement

  // Calculation details
  completedCriteria String[] // ["government_id", "email_verification", ...]
  weightedCriteria  Json // { government_id: 90, email_verification: 70, ... 
  organization      Organization? @relation(fields: [organizationId], references: [id])
  organizationId    String?
  contacts          Contact[]
}

model PropertySecurityConfig {
  id         String @id @default(cuid())
  orgId      String
  propertyId String @unique

  // Security settings
  countryCode String // TR, US, UK, etc.
  enabled     Boolean @default(true)

  // Minimum stay requirements
  minimumNights    Int  @default(3)
  peakSeasonNights Int? // Higher minimum during peak season
  holidayNights    Int? // Higher minimum during holidays

  // Price barriers
  priceMultiplier Float    @default(2.5) // 2.5x long-term rate
  priceFloor      Decimal? @db.Decimal(14, 2)

  // Operator requirements
  licensedOperatorOnly   Boolean  @default(true)
  minimumInsuranceAmount Decimal? @db.Decimal(12, 2)

  // Guest screening
  requireBackgroundCheck Boolean @default(true)
  requireGovernmentId    Boolean @default(true)
  minimumRating          Float? // Minimum guest rating

  // Physical security
  separateEntrance Boolean @default(false)
  smartElevator    Boolean @default(false)
  wristbandSystem  Boolean @default(false)

  // Check-in protocol
  checkInProtocol String // "in-person", "self-check-in", "hybrid"

  // Noise monitoring
  noiseMonitoringEnabled Boolean @default(true)
  noiseLimitDb           Int     @default(55)
  quietHoursStart        String? // "22:00"
  quietHoursEnd          String? // "08:00"

  // Enforcement
  enforcementEnabled Boolean  @default(true)
  threeStrikePolicy  Boolean  @default(true)
  firstStrikeFine    Decimal? @db.Decimal(10, 2)
  secondStrikeFine   Decimal? @db.Decimal(10, 2)
  thirdStrikeBan     Boolean  @default(true)

  // Regional overrides
  regionalOverrides Json? // Country-specific settings

  // Compliance
  lastAuditAt     DateTime?
  auditScore      Float? // 0-100
  complianceNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org      Organization @relation(fields: [orgId], references: [id])
  property Property     @relation(fields: [propertyId], references: [id])

  @@index([orgId])
  @@index([propertyId])
  @@index([countryCode])
  @@index([enabled])
}

