{
  "name": "reservatior",
  "version": "1.0.50",
  "scripts": {
    "test": "bun test",
    "test:server": "cd server && bun test",
    "test:client": "cd client && bun test",
    "test:watch": "bun test --watch",
    "build": "bunx tsc --build",
    "dev": "bun run --watch server/src/index.ts",
    "generate-all": "./generate-all.sh",
    "generate-schemas": "bun run scripts/generate-valibot-schemas.ts",
    "generate-routes": "bun run scripts/generate-all-routes.ts",
    "generate-all-api": "bun run generate-schemas && bun run generate-routes",
    "docker:build": "docker build -t reservatior .",
    "docker:run": "docker run -p 3000:3000 reservatior",
    "docker:compose:up": "docker-compose up --build"
  },
  "dependencies": {
    "@elysiajs/bearer": "^1.4.2",
    "@elysiajs/cookie": "^0.8.0",
    "@elysiajs/cors": "^1.4.0",
    "@elysiajs/eden": "^1.4.5",
    "@elysiajs/jwt": "^1.4.0",
    "@elysiajs/openapi": "^1.4.11",
    "@prisma/adapter-pg": "^6.19.2",
    "@prisma/client": "6.19.2",
    "@sinclair/typebox": "^0.34.41",
    "@zenstackhq/runtime": "^2.22.1",
    "@zenstackhq/server": "2.22.1",
    "bcryptjs": "^3.0.3",
    "elysia": "^1.4.19",
    "pg": "^8.16.3",
    "prismabox": "^1.1.26",
    "valibot": "^1.2.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.3.0",
    "@types/node": "^25.5.0",
    "@types/pg": "^8.20.0",
    "@zenstackhq/cli": "^3.5.2",
    "bun-types": "latest",
    "bunx": "^0.1.0",
    "init": "^0.1.2",
    "prisma": "6.19.2"
  },
  "module": "src/index.js"
}
