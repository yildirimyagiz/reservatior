import 'package:dio/dio.dart';
import '../../../core/network/dio_client.dart';
import '../../gen_models/models_library.dart';

class ExchangeRateService {
  final DioClient _dioClient;
  ExchangeRateService(this._dioClient);

  // ── Get by ID ──
  Future<ExchangeRate> getById(String id) async {
    if (id.isEmpty) throw ArgumentError('ID cannot be empty');
    try {
      final r = await _dioClient.get('/exchangeRate/$id');
      return ExchangeRate.fromJson(r.data['data']);
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Get all ──
  Future<List<ExchangeRate>> getAll({
    int page = 1, int limit = 20,
    Map<String, dynamic>? filters,
  }) async {
    try {
      final q = <String, dynamic>{'page': page.toString(), 'limit': limit.toString()};
      if (filters != null) q.addAll(filters);
      final r = await _dioClient.get('/exchangeRate', queryParameters: q);
      return (r.data['data'] as List).map((j) => ExchangeRate.fromJson(j)).toList();
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Get with filters ──
  Future<List<ExchangeRate>> getWithFilters({
    String? baseCurrency,
    String? quoteCurrency,
    double? rate,
    DateTime? asOfDate,
    String? source,
  }) async {
    final filters = <String, dynamic>{};
    if (baseCurrency != null) filters['baseCurrency'] = baseCurrency;
    if (quoteCurrency != null) filters['quoteCurrency'] = quoteCurrency;
    if (rate != null) filters['rate'] = rate.toString();
    if (asOfDate != null) filters['asOfDate'] = asOfDate.toIso8601String();
    if (source != null) filters['source'] = source;
    return getAll(filters: filters);
  }

  // ── Create ──
  Future<ExchangeRate> create(ExchangeRate exchangeRate) async {

    try {
      final r = await _dioClient.post('/exchangeRate', data: exchangeRate.toJson());
      return ExchangeRate.fromJson(r.data['data']);
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Update ──
  Future<ExchangeRate> update(String id, ExchangeRate exchangeRate) async {
    if (id.isEmpty) throw ArgumentError('ID cannot be empty');
    try {
      final r = await _dioClient.put('/exchangeRate/$id', data: exchangeRate.toJson());
      return ExchangeRate.fromJson(r.data['data']);
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Delete ──
  Future<void> delete(String id) async {
    if (id.isEmpty) throw ArgumentError('ID cannot be empty');
    try {
      await _dioClient.delete('/exchangeRate/$id');
    } on DioException catch (e) { throw _err(e); }
  }

  Exception _err(DioException e) {
    switch (e.type) {
      case DioExceptionType.connectionTimeout:
        return Exception('Connection timeout. Check your internet connection.');
      case DioExceptionType.badResponse:
        final msg = e.response?.data?['message'] ?? 'Server error';
        return Exception('Server error: $msg');
      case DioExceptionType.connectionError:
        return Exception('Network error. Check your internet connection.');
      default:
        return Exception('Request failed: ${e.message}');
    }
  }
}