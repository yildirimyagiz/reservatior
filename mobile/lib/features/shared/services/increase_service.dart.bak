import 'package:dio/dio.dart';
import '../../../core/network/dio_client.dart';
import '../../gen_models/models_library.dart';

class IncreaseService {
  final DioClient _dioClient;
  IncreaseService(this._dioClient);

  // ── Get by ID ──
  Future<Increase> getById(String id) async {
    if (id.isEmpty) throw ArgumentError('ID cannot be empty');
    try {
      final r = await _dioClient.get('/increase/$id');
      return Increase.fromJson(r.data['data']);
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Get all ──
  Future<List<Increase>> getAll({
    int page = 1, int limit = 20,
    Map<String, dynamic>? filters,
  }) async {
    try {
      final q = <String, dynamic>{'page': page.toString(), 'limit': limit.toString()};
      if (filters != null) q.addAll(filters);
      final r = await _dioClient.get('/increase', queryParameters: q);
      return (r.data['data'] as List).map((j) => Increase.fromJson(j)).toList();
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Get with filters ──
  Future<List<Increase>> getWithFilters({
    String? proposedBy,
    double? oldRent,
    double? newRent,
    DateTime? effectiveDate,
    IncreaseStatus? status,
  }) async {
    final filters = <String, dynamic>{};
    if (proposedBy != null) filters['proposedBy'] = proposedBy;
    if (oldRent != null) filters['oldRent'] = oldRent.toString();
    if (newRent != null) filters['newRent'] = newRent.toString();
    if (effectiveDate != null) filters['effectiveDate'] = effectiveDate.toIso8601String();
    if (status != null) filters['status'] = status.toString();
    return getAll(filters: filters);
  }

  // ── Create ──
  Future<Increase> create(Increase increase) async {

    try {
      final r = await _dioClient.post('/increase', data: increase.toJson());
      return Increase.fromJson(r.data['data']);
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Update ──
  Future<Increase> update(String id, Increase increase) async {
    if (id.isEmpty) throw ArgumentError('ID cannot be empty');
    try {
      final r = await _dioClient.put('/increase/$id', data: increase.toJson());
      return Increase.fromJson(r.data['data']);
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Delete ──
  Future<void> delete(String id) async {
    if (id.isEmpty) throw ArgumentError('ID cannot be empty');
    try {
      await _dioClient.delete('/increase/$id');
    } on DioException catch (e) { throw _err(e); }
  }

  Exception _err(DioException e) {
    switch (e.type) {
      case DioExceptionType.connectionTimeout:
        return Exception('Connection timeout. Check your internet connection.');
      case DioExceptionType.badResponse:
        final msg = e.response?.data?['message'] ?? 'Server error';
        return Exception('Server error: $msg');
      case DioExceptionType.connectionError:
        return Exception('Network error. Check your internet connection.');
      default:
        return Exception('Request failed: ${e.message}');
    }
  }
}