import 'package:dio/dio.dart';
import '../../../core/network/dio_client.dart';
import '../../gen_models/models_library.dart';

class ScrapingJobService {
  final DioClient _dioClient;
  ScrapingJobService(this._dioClient);

  // ── Get by ID ──
  Future<ScrapingJob> getById(String id) async {
    if (id.isEmpty) throw ArgumentError('ID cannot be empty');
    try {
      final r = await _dioClient.get('/scrapingJob/$id');
      return ScrapingJob.fromJson(r.data['data']);
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Get all ──
  Future<List<ScrapingJob>> getAll({
    int page = 1, int limit = 20,
    Map<String, dynamic>? filters,
  }) async {
    try {
      final q = <String, dynamic>{'page': page.toString(), 'limit': limit.toString()};
      if (filters != null) q.addAll(filters);
      final r = await _dioClient.get('/scrapingJob', queryParameters: q);
      return (r.data['data'] as List).map((j) => ScrapingJob.fromJson(j)).toList();
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Get with filters ──
  Future<List<ScrapingJob>> getWithFilters({
    String? jobType,
    String? status,
    DateTime? startTime,
    DateTime? endTime,
    int? projectsScraped,
  }) async {
    final filters = <String, dynamic>{};
    if (jobType != null) filters['jobType'] = jobType;
    if (status != null) filters['status'] = status;
    if (startTime != null) filters['startTime'] = startTime.toIso8601String();
    if (endTime != null) filters['endTime'] = endTime.toIso8601String();
    if (projectsScraped != null) filters['projectsScraped'] = projectsScraped.toString();
    return getAll(filters: filters);
  }

  // ── Create ──
  Future<ScrapingJob> create(ScrapingJob scrapingJob) async {

    try {
      final r = await _dioClient.post('/scrapingJob', data: scrapingJob.toJson());
      return ScrapingJob.fromJson(r.data['data']);
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Update ──
  Future<ScrapingJob> update(String id, ScrapingJob scrapingJob) async {
    if (id.isEmpty) throw ArgumentError('ID cannot be empty');
    try {
      final r = await _dioClient.put('/scrapingJob/$id', data: scrapingJob.toJson());
      return ScrapingJob.fromJson(r.data['data']);
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Delete ──
  Future<void> delete(String id) async {
    if (id.isEmpty) throw ArgumentError('ID cannot be empty');
    try {
      await _dioClient.delete('/scrapingJob/$id');
    } on DioException catch (e) { throw _err(e); }
  }

  Exception _err(DioException e) {
    switch (e.type) {
      case DioExceptionType.connectionTimeout:
        return Exception('Connection timeout. Check your internet connection.');
      case DioExceptionType.badResponse:
        final msg = e.response?.data?['message'] ?? 'Server error';
        return Exception('Server error: $msg');
      case DioExceptionType.connectionError:
        return Exception('Network error. Check your internet connection.');
      default:
        return Exception('Request failed: ${e.message}');
    }
  }
}