import 'package:dio/dio.dart';
import '../../../core/network/dio_client.dart';
import '../../gen_models/models_library.dart';

class ClientRelationshipService {
  final DioClient _dioClient;
  ClientRelationshipService(this._dioClient);

  // ── Get by ID ──
  Future<ClientRelationship> getById(String id) async {
    if (id.isEmpty) throw ArgumentError('ID cannot be empty');
    try {
      final r = await _dioClient.get('/clientRelationship/$id');
      return ClientRelationship.fromJson(r.data['data']);
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Get all ──
  Future<List<ClientRelationship>> getAll({
    int page = 1, int limit = 20,
    Map<String, dynamic>? filters,
  }) async {
    try {
      final q = <String, dynamic>{'page': page.toString(), 'limit': limit.toString()};
      if (filters != null) q.addAll(filters);
      final r = await _dioClient.get('/clientRelationship', queryParameters: q);
      return (r.data['data'] as List).map((j) => ClientRelationship.fromJson(j)).toList();
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Get with filters ──
  Future<List<ClientRelationship>> getWithFilters({
    RelationshipStatus? status,
    DateTime? firstContact,
    DateTime? lastContact,
    String? contactFrequency,
    NotificationChannel? preferredChannel,
  }) async {
    final filters = <String, dynamic>{};
    if (status != null) filters['status'] = status.toString();
    if (firstContact != null) filters['firstContact'] = firstContact.toIso8601String();
    if (lastContact != null) filters['lastContact'] = lastContact.toIso8601String();
    if (contactFrequency != null) filters['contactFrequency'] = contactFrequency;
    if (preferredChannel != null) filters['preferredChannel'] = preferredChannel.toString();
    return getAll(filters: filters);
  }

  // ── Create ──
  Future<ClientRelationship> create(ClientRelationship clientRelationship) async {

    try {
      final r = await _dioClient.post('/clientRelationship', data: clientRelationship.toJson());
      return ClientRelationship.fromJson(r.data['data']);
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Update ──
  Future<ClientRelationship> update(String id, ClientRelationship clientRelationship) async {
    if (id.isEmpty) throw ArgumentError('ID cannot be empty');
    try {
      final r = await _dioClient.put('/clientRelationship/$id', data: clientRelationship.toJson());
      return ClientRelationship.fromJson(r.data['data']);
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Delete ──
  Future<void> delete(String id) async {
    if (id.isEmpty) throw ArgumentError('ID cannot be empty');
    try {
      await _dioClient.delete('/clientRelationship/$id');
    } on DioException catch (e) { throw _err(e); }
  }

  Exception _err(DioException e) {
    switch (e.type) {
      case DioExceptionType.connectionTimeout:
        return Exception('Connection timeout. Check your internet connection.');
      case DioExceptionType.badResponse:
        final msg = e.response?.data?['message'] ?? 'Server error';
        return Exception('Server error: $msg');
      case DioExceptionType.connectionError:
        return Exception('Network error. Check your internet connection.');
      default:
        return Exception('Request failed: ${e.message}');
    }
  }
}