import 'package:dio/dio.dart';
import '../../../core/network/dio_client.dart';
import '../../gen_models/models_library.dart';

class EscrowDisputeService {
  final DioClient _dioClient;
  EscrowDisputeService(this._dioClient);

  // ── Get by ID ──
  Future<EscrowDispute> getById(String id) async {
    if (id.isEmpty) throw ArgumentError('ID cannot be empty');
    try {
      final r = await _dioClient.get('/escrowDispute/$id');
      return EscrowDispute.fromJson(r.data['data']);
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Get all ──
  Future<List<EscrowDispute>> getAll({
    int page = 1, int limit = 20,
    Map<String, dynamic>? filters,
  }) async {
    try {
      final q = <String, dynamic>{'page': page.toString(), 'limit': limit.toString()};
      if (filters != null) q.addAll(filters);
      final r = await _dioClient.get('/escrowDispute', queryParameters: q);
      return (r.data['data'] as List).map((j) => EscrowDispute.fromJson(j)).toList();
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Get with filters ──
  Future<List<EscrowDispute>> getWithFilters({
    EscrowDisputeParty? openedBy,
    EscrowDisputeType? disputeType,
    String? description,
    double? claimedAmount,
    String? currency,
  }) async {
    final filters = <String, dynamic>{};
    if (openedBy != null) filters['openedBy'] = openedBy.toString();
    if (disputeType != null) filters['disputeType'] = disputeType.toString();
    if (description != null) filters['description'] = description;
    if (claimedAmount != null) filters['claimedAmount'] = claimedAmount.toString();
    if (currency != null) filters['currency'] = currency;
    return getAll(filters: filters);
  }

  // ── Create ──
  Future<EscrowDispute> create(EscrowDispute escrowDispute) async {

    try {
      final r = await _dioClient.post('/escrowDispute', data: escrowDispute.toJson());
      return EscrowDispute.fromJson(r.data['data']);
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Update ──
  Future<EscrowDispute> update(String id, EscrowDispute escrowDispute) async {
    if (id.isEmpty) throw ArgumentError('ID cannot be empty');
    try {
      final r = await _dioClient.put('/escrowDispute/$id', data: escrowDispute.toJson());
      return EscrowDispute.fromJson(r.data['data']);
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Delete ──
  Future<void> delete(String id) async {
    if (id.isEmpty) throw ArgumentError('ID cannot be empty');
    try {
      await _dioClient.delete('/escrowDispute/$id');
    } on DioException catch (e) { throw _err(e); }
  }

  Exception _err(DioException e) {
    switch (e.type) {
      case DioExceptionType.connectionTimeout:
        return Exception('Connection timeout. Check your internet connection.');
      case DioExceptionType.badResponse:
        final msg = e.response?.data?['message'] ?? 'Server error';
        return Exception('Server error: $msg');
      case DioExceptionType.connectionError:
        return Exception('Network error. Check your internet connection.');
      default:
        return Exception('Request failed: ${e.message}');
    }
  }
}