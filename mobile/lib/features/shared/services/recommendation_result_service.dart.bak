import 'package:dio/dio.dart';
import '../../../core/network/dio_client.dart';
import '../../gen_models/models_library.dart';

class RecommendationResultService {
  final DioClient _dioClient;
  RecommendationResultService(this._dioClient);

  // ── Get by ID ──
  Future<RecommendationResult> getById(String id) async {
    if (id.isEmpty) throw ArgumentError('ID cannot be empty');
    try {
      final r = await _dioClient.get('/recommendationResult/$id');
      return RecommendationResult.fromJson(r.data['data']);
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Get all ──
  Future<List<RecommendationResult>> getAll({
    int page = 1, int limit = 20,
    Map<String, dynamic>? filters,
  }) async {
    try {
      final q = <String, dynamic>{'page': page.toString(), 'limit': limit.toString()};
      if (filters != null) q.addAll(filters);
      final r = await _dioClient.get('/recommendationResult', queryParameters: q);
      return (r.data['data'] as List).map((j) => RecommendationResult.fromJson(j)).toList();
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Get with filters ──
  Future<List<RecommendationResult>> getWithFilters({
    int? score,
    String? explanation,
    dynamic? breakdown,
  }) async {
    final filters = <String, dynamic>{};
    if (score != null) filters['score'] = score.toString();
    if (explanation != null) filters['explanation'] = explanation;
    if (breakdown != null) filters['breakdown'] = breakdown.toString();
    return getAll(filters: filters);
  }

  // ── Create ──
  Future<RecommendationResult> create(RecommendationResult recommendationResult) async {

    try {
      final r = await _dioClient.post('/recommendationResult', data: recommendationResult.toJson());
      return RecommendationResult.fromJson(r.data['data']);
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Update ──
  Future<RecommendationResult> update(String id, RecommendationResult recommendationResult) async {
    if (id.isEmpty) throw ArgumentError('ID cannot be empty');
    try {
      final r = await _dioClient.put('/recommendationResult/$id', data: recommendationResult.toJson());
      return RecommendationResult.fromJson(r.data['data']);
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Delete ──
  Future<void> delete(String id) async {
    if (id.isEmpty) throw ArgumentError('ID cannot be empty');
    try {
      await _dioClient.delete('/recommendationResult/$id');
    } on DioException catch (e) { throw _err(e); }
  }

  Exception _err(DioException e) {
    switch (e.type) {
      case DioExceptionType.connectionTimeout:
        return Exception('Connection timeout. Check your internet connection.');
      case DioExceptionType.badResponse:
        final msg = e.response?.data?['message'] ?? 'Server error';
        return Exception('Server error: $msg');
      case DioExceptionType.connectionError:
        return Exception('Network error. Check your internet connection.');
      default:
        return Exception('Request failed: ${e.message}');
    }
  }
}