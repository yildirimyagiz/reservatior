import 'package:dio/dio.dart';
import '../../../core/network/dio_client.dart';
import '../../gen_models/models_library.dart';

class PropertyComplianceService {
  final DioClient _dioClient;
  PropertyComplianceService(this._dioClient);

  // ── Get by ID ──
  Future<PropertyCompliance> getById(String id) async {
    if (id.isEmpty) throw ArgumentError('ID cannot be empty');
    try {
      final r = await _dioClient.get('/propertyCompliance/$id');
      return PropertyCompliance.fromJson(r.data['data']);
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Get all ──
  Future<List<PropertyCompliance>> getAll({
    int page = 1, int limit = 20,
    Map<String, dynamic>? filters,
  }) async {
    try {
      final q = <String, dynamic>{'page': page.toString(), 'limit': limit.toString()};
      if (filters != null) q.addAll(filters);
      final r = await _dioClient.get('/propertyCompliance', queryParameters: q);
      return (r.data['data'] as List).map((j) => PropertyCompliance.fromJson(j)).toList();
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Get with filters ──
  Future<List<PropertyCompliance>> getWithFilters({
    String? type,
    String? status,
    dynamic? data,
  }) async {
    final filters = <String, dynamic>{};
    if (type != null) filters['type'] = type;
    if (status != null) filters['status'] = status;
    if (data != null) filters['data'] = data.toString();
    return getAll(filters: filters);
  }

  // ── Create ──
  Future<PropertyCompliance> create(PropertyCompliance propertyCompliance) async {
    if (propertyCompliance.type == null || propertyCompliance.type!.isEmpty) {
      throw ArgumentError('type is required');
    }
    try {
      final r = await _dioClient.post('/propertyCompliance', data: propertyCompliance.toJson());
      return PropertyCompliance.fromJson(r.data['data']);
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Update ──
  Future<PropertyCompliance> update(String id, PropertyCompliance propertyCompliance) async {
    if (id.isEmpty) throw ArgumentError('ID cannot be empty');
    try {
      final r = await _dioClient.put('/propertyCompliance/$id', data: propertyCompliance.toJson());
      return PropertyCompliance.fromJson(r.data['data']);
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Delete ──
  Future<void> delete(String id) async {
    if (id.isEmpty) throw ArgumentError('ID cannot be empty');
    try {
      await _dioClient.delete('/propertyCompliance/$id');
    } on DioException catch (e) { throw _err(e); }
  }

  Exception _err(DioException e) {
    switch (e.type) {
      case DioExceptionType.connectionTimeout:
        return Exception('Connection timeout. Check your internet connection.');
      case DioExceptionType.badResponse:
        final msg = e.response?.data?['message'] ?? 'Server error';
        return Exception('Server error: $msg');
      case DioExceptionType.connectionError:
        return Exception('Network error. Check your internet connection.');
      default:
        return Exception('Request failed: ${e.message}');
    }
  }
}