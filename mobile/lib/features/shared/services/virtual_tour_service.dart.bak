import 'package:dio/dio.dart';
import '../../../core/network/dio_client.dart';
import '../../gen_models/models_library.dart';

class VirtualTourService {
  final DioClient _dioClient;
  VirtualTourService(this._dioClient);

  // ── Get by ID ──
  Future<VirtualTour> getById(String id) async {
    if (id.isEmpty) throw ArgumentError('ID cannot be empty');
    try {
      final r = await _dioClient.get('/virtualTour/$id');
      return VirtualTour.fromJson(r.data['data']);
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Get all ──
  Future<List<VirtualTour>> getAll({
    int page = 1, int limit = 20,
    Map<String, dynamic>? filters,
  }) async {
    try {
      final q = <String, dynamic>{'page': page.toString(), 'limit': limit.toString()};
      if (filters != null) q.addAll(filters);
      final r = await _dioClient.get('/virtualTour', queryParameters: q);
      return (r.data['data'] as List).map((j) => VirtualTour.fromJson(j)).toList();
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Get with filters ──
  Future<List<VirtualTour>> getWithFilters({
    String? name,
    String? description,
    String? tourType,
    String? videoUrl,
    String? embedCode,
  }) async {
    final filters = <String, dynamic>{};
    if (name != null) filters['name'] = name;
    if (description != null) filters['description'] = description;
    if (tourType != null) filters['tourType'] = tourType;
    if (videoUrl != null) filters['videoUrl'] = videoUrl;
    if (embedCode != null) filters['embedCode'] = embedCode;
    return getAll(filters: filters);
  }

  // ── Create ──
  Future<VirtualTour> create(VirtualTour virtualTour) async {
    if (virtualTour.name == null || virtualTour.name!.isEmpty) {
      throw ArgumentError('name is required');
    }
    try {
      final r = await _dioClient.post('/virtualTour', data: virtualTour.toJson());
      return VirtualTour.fromJson(r.data['data']);
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Update ──
  Future<VirtualTour> update(String id, VirtualTour virtualTour) async {
    if (id.isEmpty) throw ArgumentError('ID cannot be empty');
    try {
      final r = await _dioClient.put('/virtualTour/$id', data: virtualTour.toJson());
      return VirtualTour.fromJson(r.data['data']);
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Delete ──
  Future<void> delete(String id) async {
    if (id.isEmpty) throw ArgumentError('ID cannot be empty');
    try {
      await _dioClient.delete('/virtualTour/$id');
    } on DioException catch (e) { throw _err(e); }
  }

  Exception _err(DioException e) {
    switch (e.type) {
      case DioExceptionType.connectionTimeout:
        return Exception('Connection timeout. Check your internet connection.');
      case DioExceptionType.badResponse:
        final msg = e.response?.data?['message'] ?? 'Server error';
        return Exception('Server error: $msg');
      case DioExceptionType.connectionError:
        return Exception('Network error. Check your internet connection.');
      default:
        return Exception('Request failed: ${e.message}');
    }
  }
}