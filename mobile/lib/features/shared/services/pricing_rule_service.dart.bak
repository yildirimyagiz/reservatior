import 'package:dio/dio.dart';
import '../../../core/network/dio_client.dart';
import '../../gen_models/models_library.dart';

class PricingRuleService {
  final DioClient _dioClient;
  PricingRuleService(this._dioClient);

  // ── Get by ID ──
  Future<PricingRule> getById(String id) async {
    if (id.isEmpty) throw ArgumentError('ID cannot be empty');
    try {
      final r = await _dioClient.get('/pricingRule/$id');
      return PricingRule.fromJson(r.data['data']);
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Get all ──
  Future<List<PricingRule>> getAll({
    int page = 1, int limit = 20,
    Map<String, dynamic>? filters,
  }) async {
    try {
      final q = <String, dynamic>{'page': page.toString(), 'limit': limit.toString()};
      if (filters != null) q.addAll(filters);
      final r = await _dioClient.get('/pricingRule', queryParameters: q);
      return (r.data['data'] as List).map((j) => PricingRule.fromJson(j)).toList();
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Get with filters ──
  Future<List<PricingRule>> getWithFilters({
    String? name,
    String? description,
    String? ruleType,
    dynamic? conditions,
    dynamic? actions,
  }) async {
    final filters = <String, dynamic>{};
    if (name != null) filters['name'] = name;
    if (description != null) filters['description'] = description;
    if (ruleType != null) filters['ruleType'] = ruleType;
    if (conditions != null) filters['conditions'] = conditions.toString();
    if (actions != null) filters['actions'] = actions.toString();
    return getAll(filters: filters);
  }

  // ── Create ──
  Future<PricingRule> create(PricingRule pricingRule) async {
    if (pricingRule.name == null || pricingRule.name!.isEmpty) {
      throw ArgumentError('name is required');
    }
    try {
      final r = await _dioClient.post('/pricingRule', data: pricingRule.toJson());
      return PricingRule.fromJson(r.data['data']);
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Update ──
  Future<PricingRule> update(String id, PricingRule pricingRule) async {
    if (id.isEmpty) throw ArgumentError('ID cannot be empty');
    try {
      final r = await _dioClient.put('/pricingRule/$id', data: pricingRule.toJson());
      return PricingRule.fromJson(r.data['data']);
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Delete ──
  Future<void> delete(String id) async {
    if (id.isEmpty) throw ArgumentError('ID cannot be empty');
    try {
      await _dioClient.delete('/pricingRule/$id');
    } on DioException catch (e) { throw _err(e); }
  }

  Exception _err(DioException e) {
    switch (e.type) {
      case DioExceptionType.connectionTimeout:
        return Exception('Connection timeout. Check your internet connection.');
      case DioExceptionType.badResponse:
        final msg = e.response?.data?['message'] ?? 'Server error';
        return Exception('Server error: $msg');
      case DioExceptionType.connectionError:
        return Exception('Network error. Check your internet connection.');
      default:
        return Exception('Request failed: ${e.message}');
    }
  }
}