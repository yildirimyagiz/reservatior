import 'package:dio/dio.dart';
import '../../../core/network/dio_client.dart';
import '../../gen_models/models_library.dart';

class PredictiveModelService {
  final DioClient _dioClient;
  PredictiveModelService(this._dioClient);

  // ── Get by ID ──
  Future<PredictiveModel> getById(String id) async {
    if (id.isEmpty) throw ArgumentError('ID cannot be empty');
    try {
      final r = await _dioClient.get('/predictiveModel/$id');
      return PredictiveModel.fromJson(r.data['data']);
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Get all ──
  Future<List<PredictiveModel>> getAll({
    int page = 1, int limit = 20,
    Map<String, dynamic>? filters,
  }) async {
    try {
      final q = <String, dynamic>{'page': page.toString(), 'limit': limit.toString()};
      if (filters != null) q.addAll(filters);
      final r = await _dioClient.get('/predictiveModel', queryParameters: q);
      return (r.data['data'] as List).map((j) => PredictiveModel.fromJson(j)).toList();
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Get with filters ──
  Future<List<PredictiveModel>> getWithFilters({
    ModelType? modelType,
    dynamic? trainingData,
    dynamic? parameters,
    double? accuracy,
    DateTime? lastTrained,
  }) async {
    final filters = <String, dynamic>{};
    if (modelType != null) filters['modelType'] = modelType.toString();
    if (trainingData != null) filters['trainingData'] = trainingData.toString();
    if (parameters != null) filters['parameters'] = parameters.toString();
    if (accuracy != null) filters['accuracy'] = accuracy.toString();
    if (lastTrained != null) filters['lastTrained'] = lastTrained.toIso8601String();
    return getAll(filters: filters);
  }

  // ── Create ──
  Future<PredictiveModel> create(PredictiveModel predictiveModel) async {

    try {
      final r = await _dioClient.post('/predictiveModel', data: predictiveModel.toJson());
      return PredictiveModel.fromJson(r.data['data']);
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Update ──
  Future<PredictiveModel> update(String id, PredictiveModel predictiveModel) async {
    if (id.isEmpty) throw ArgumentError('ID cannot be empty');
    try {
      final r = await _dioClient.put('/predictiveModel/$id', data: predictiveModel.toJson());
      return PredictiveModel.fromJson(r.data['data']);
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Delete ──
  Future<void> delete(String id) async {
    if (id.isEmpty) throw ArgumentError('ID cannot be empty');
    try {
      await _dioClient.delete('/predictiveModel/$id');
    } on DioException catch (e) { throw _err(e); }
  }

  Exception _err(DioException e) {
    switch (e.type) {
      case DioExceptionType.connectionTimeout:
        return Exception('Connection timeout. Check your internet connection.');
      case DioExceptionType.badResponse:
        final msg = e.response?.data?['message'] ?? 'Server error';
        return Exception('Server error: $msg');
      case DioExceptionType.connectionError:
        return Exception('Network error. Check your internet connection.');
      default:
        return Exception('Request failed: ${e.message}');
    }
  }
}