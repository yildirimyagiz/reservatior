import 'package:dio/dio.dart';
import '../../../core/network/dio_client.dart';
import '../../gen_models/models_library.dart';

class MobileDeviceService {
  final DioClient _dioClient;
  MobileDeviceService(this._dioClient);

  // ── Get by ID ──
  Future<MobileDevice> getById(String id) async {
    if (id.isEmpty) throw ArgumentError('ID cannot be empty');
    try {
      final r = await _dioClient.get('/mobileDevice/$id');
      return MobileDevice.fromJson(r.data['data']);
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Get all ──
  Future<List<MobileDevice>> getAll({
    int page = 1, int limit = 20,
    Map<String, dynamic>? filters,
  }) async {
    try {
      final q = <String, dynamic>{'page': page.toString(), 'limit': limit.toString()};
      if (filters != null) q.addAll(filters);
      final r = await _dioClient.get('/mobileDevice', queryParameters: q);
      return (r.data['data'] as List).map((j) => MobileDevice.fromJson(j)).toList();
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Get with filters ──
  Future<List<MobileDevice>> getWithFilters({
    String? deviceType,
    String? deviceToken,
    String? appVersion,
    String? osVersion,
    bool? isActive,
  }) async {
    final filters = <String, dynamic>{};
    if (deviceType != null) filters['deviceType'] = deviceType;
    if (deviceToken != null) filters['deviceToken'] = deviceToken;
    if (appVersion != null) filters['appVersion'] = appVersion;
    if (osVersion != null) filters['osVersion'] = osVersion;
    if (isActive != null) filters['isActive'] = isActive.toString();
    return getAll(filters: filters);
  }

  // ── Create ──
  Future<MobileDevice> create(MobileDevice mobileDevice) async {

    try {
      final r = await _dioClient.post('/mobileDevice', data: mobileDevice.toJson());
      return MobileDevice.fromJson(r.data['data']);
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Update ──
  Future<MobileDevice> update(String id, MobileDevice mobileDevice) async {
    if (id.isEmpty) throw ArgumentError('ID cannot be empty');
    try {
      final r = await _dioClient.put('/mobileDevice/$id', data: mobileDevice.toJson());
      return MobileDevice.fromJson(r.data['data']);
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Delete ──
  Future<void> delete(String id) async {
    if (id.isEmpty) throw ArgumentError('ID cannot be empty');
    try {
      await _dioClient.delete('/mobileDevice/$id');
    } on DioException catch (e) { throw _err(e); }
  }

  Exception _err(DioException e) {
    switch (e.type) {
      case DioExceptionType.connectionTimeout:
        return Exception('Connection timeout. Check your internet connection.');
      case DioExceptionType.badResponse:
        final msg = e.response?.data?['message'] ?? 'Server error';
        return Exception('Server error: $msg');
      case DioExceptionType.connectionError:
        return Exception('Network error. Check your internet connection.');
      default:
        return Exception('Request failed: ${e.message}');
    }
  }
}