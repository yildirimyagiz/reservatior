import 'package:dio/dio.dart';
import '../../../core/network/dio_client.dart';
import '../../gen_models/models_library.dart';

class ContractService {
  final DioClient _dioClient;
  ContractService(this._dioClient);

  // ── Get by ID ──
  Future<Contract> getById(String id) async {
    if (id.isEmpty) throw ArgumentError('ID cannot be empty');
    try {
      final r = await _dioClient.get('/contract/$id');
      return Contract.fromJson(r.data['data']);
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Get all ──
  Future<List<Contract>> getAll({
    int page = 1, int limit = 20,
    Map<String, dynamic>? filters,
  }) async {
    try {
      final q = <String, dynamic>{'page': page.toString(), 'limit': limit.toString()};
      if (filters != null) q.addAll(filters);
      final r = await _dioClient.get('/contract', queryParameters: q);
      return (r.data['data'] as List).map((j) => Contract.fromJson(j)).toList();
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Get with filters ──
  Future<List<Contract>> getWithFilters({
    ContractType? type,
    ContractStatus? status,
    String? title,
    DateTime? effectiveFrom,
    DateTime? effectiveTo,
  }) async {
    final filters = <String, dynamic>{};
    if (type != null) filters['type'] = type.toString();
    if (status != null) filters['status'] = status.toString();
    if (title != null) filters['title'] = title;
    if (effectiveFrom != null) filters['effectiveFrom'] = effectiveFrom.toIso8601String();
    if (effectiveTo != null) filters['effectiveTo'] = effectiveTo.toIso8601String();
    return getAll(filters: filters);
  }

  // ── Create ──
  Future<Contract> create(Contract contract) async {
    if (contract.type == null || contract.type!.isEmpty) {
      throw ArgumentError('type is required');
    }
    if (contract.title == null || contract.title!.isEmpty) {
      throw ArgumentError('title is required');
    }
    try {
      final r = await _dioClient.post('/contract', data: contract.toJson());
      return Contract.fromJson(r.data['data']);
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Update ──
  Future<Contract> update(String id, Contract contract) async {
    if (id.isEmpty) throw ArgumentError('ID cannot be empty');
    try {
      final r = await _dioClient.put('/contract/$id', data: contract.toJson());
      return Contract.fromJson(r.data['data']);
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Delete ──
  Future<void> delete(String id) async {
    if (id.isEmpty) throw ArgumentError('ID cannot be empty');
    try {
      await _dioClient.delete('/contract/$id');
    } on DioException catch (e) { throw _err(e); }
  }

  Exception _err(DioException e) {
    switch (e.type) {
      case DioExceptionType.connectionTimeout:
        return Exception('Connection timeout. Check your internet connection.');
      case DioExceptionType.badResponse:
        final msg = e.response?.data?['message'] ?? 'Server error';
        return Exception('Server error: $msg');
      case DioExceptionType.connectionError:
        return Exception('Network error. Check your internet connection.');
      default:
        return Exception('Request failed: ${e.message}');
    }
  }
}