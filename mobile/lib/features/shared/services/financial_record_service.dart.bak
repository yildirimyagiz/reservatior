import 'package:dio/dio.dart';
import '../../../core/network/dio_client.dart';
import '../../gen_models/models_library.dart';

class FinancialRecordService {
  final DioClient _dioClient;
  FinancialRecordService(this._dioClient);

  // ── Get by ID ──
  Future<FinancialRecord> getById(String id) async {
    if (id.isEmpty) throw ArgumentError('ID cannot be empty');
    try {
      final r = await _dioClient.get('/financialRecord/$id');
      return FinancialRecord.fromJson(r.data['data']);
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Get all ──
  Future<List<FinancialRecord>> getAll({
    int page = 1, int limit = 20,
    Map<String, dynamic>? filters,
  }) async {
    try {
      final q = <String, dynamic>{'page': page.toString(), 'limit': limit.toString()};
      if (filters != null) q.addAll(filters);
      final r = await _dioClient.get('/financialRecord', queryParameters: q);
      return (r.data['data'] as List).map((j) => FinancialRecord.fromJson(j)).toList();
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Get with filters ──
  Future<List<FinancialRecord>> getWithFilters({
    String? type,
    TransactionType? recordType,
    double? amount,
    String? currency,
    DateTime? occurredAt,
  }) async {
    final filters = <String, dynamic>{};
    if (type != null) filters['type'] = type;
    if (recordType != null) filters['recordType'] = recordType.toString();
    if (amount != null) filters['amount'] = amount.toString();
    if (currency != null) filters['currency'] = currency;
    if (occurredAt != null) filters['occurredAt'] = occurredAt.toIso8601String();
    return getAll(filters: filters);
  }

  // ── Create ──
  Future<FinancialRecord> create(FinancialRecord financialRecord) async {
    if (financialRecord.type == null || financialRecord.type!.isEmpty) {
      throw ArgumentError('type is required');
    }
    try {
      final r = await _dioClient.post('/financialRecord', data: financialRecord.toJson());
      return FinancialRecord.fromJson(r.data['data']);
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Update ──
  Future<FinancialRecord> update(String id, FinancialRecord financialRecord) async {
    if (id.isEmpty) throw ArgumentError('ID cannot be empty');
    try {
      final r = await _dioClient.put('/financialRecord/$id', data: financialRecord.toJson());
      return FinancialRecord.fromJson(r.data['data']);
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Delete ──
  Future<void> delete(String id) async {
    if (id.isEmpty) throw ArgumentError('ID cannot be empty');
    try {
      await _dioClient.delete('/financialRecord/$id');
    } on DioException catch (e) { throw _err(e); }
  }

  Exception _err(DioException e) {
    switch (e.type) {
      case DioExceptionType.connectionTimeout:
        return Exception('Connection timeout. Check your internet connection.');
      case DioExceptionType.badResponse:
        final msg = e.response?.data?['message'] ?? 'Server error';
        return Exception('Server error: $msg');
      case DioExceptionType.connectionError:
        return Exception('Network error. Check your internet connection.');
      default:
        return Exception('Request failed: ${e.message}');
    }
  }
}