import 'package:dio/dio.dart';
import '../../../core/network/dio_client.dart';
import '../../gen_models/models_library.dart';

class CurrencyService {
  final DioClient _dioClient;
  CurrencyService(this._dioClient);

  // ── Get by ID ──
  Future<Currency> getById(String id) async {
    if (id.isEmpty) throw ArgumentError('ID cannot be empty');
    try {
      final r = await _dioClient.get('/currency/$id');
      return Currency.fromJson(r.data['data']);
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Get all ──
  Future<List<Currency>> getAll({
    int page = 1, int limit = 20,
    Map<String, dynamic>? filters,
  }) async {
    try {
      final q = <String, dynamic>{'page': page.toString(), 'limit': limit.toString()};
      if (filters != null) q.addAll(filters);
      final r = await _dioClient.get('/currency', queryParameters: q);
      return (r.data['data'] as List).map((j) => Currency.fromJson(j)).toList();
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Get with filters ──
  Future<List<Currency>> getWithFilters({
    String? code,
    String? name,
    String? symbol,
    double? exchangeRate,
    bool? isActive,
  }) async {
    final filters = <String, dynamic>{};
    if (code != null) filters['code'] = code;
    if (name != null) filters['name'] = name;
    if (symbol != null) filters['symbol'] = symbol;
    if (exchangeRate != null) filters['exchangeRate'] = exchangeRate.toString();
    if (isActive != null) filters['isActive'] = isActive.toString();
    return getAll(filters: filters);
  }

  // ── Create ──
  Future<Currency> create(Currency currency) async {
    if (currency.name == null || currency.name!.isEmpty) {
      throw ArgumentError('name is required');
    }
    try {
      final r = await _dioClient.post('/currency', data: currency.toJson());
      return Currency.fromJson(r.data['data']);
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Update ──
  Future<Currency> update(String id, Currency currency) async {
    if (id.isEmpty) throw ArgumentError('ID cannot be empty');
    try {
      final r = await _dioClient.put('/currency/$id', data: currency.toJson());
      return Currency.fromJson(r.data['data']);
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Delete ──
  Future<void> delete(String id) async {
    if (id.isEmpty) throw ArgumentError('ID cannot be empty');
    try {
      await _dioClient.delete('/currency/$id');
    } on DioException catch (e) { throw _err(e); }
  }

  Exception _err(DioException e) {
    switch (e.type) {
      case DioExceptionType.connectionTimeout:
        return Exception('Connection timeout. Check your internet connection.');
      case DioExceptionType.badResponse:
        final msg = e.response?.data?['message'] ?? 'Server error';
        return Exception('Server error: $msg');
      case DioExceptionType.connectionError:
        return Exception('Network error. Check your internet connection.');
      default:
        return Exception('Request failed: ${e.message}');
    }
  }
}