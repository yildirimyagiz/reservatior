import 'package:dio/dio.dart';
import '../../../core/network/dio_client.dart';
import '../../gen_models/models_library.dart';

class PerformanceAlertService {
  final DioClient _dioClient;
  PerformanceAlertService(this._dioClient);

  // ── Get by ID ──
  Future<PerformanceAlert> getById(String id) async {
    if (id.isEmpty) throw ArgumentError('ID cannot be empty');
    try {
      final r = await _dioClient.get('/performanceAlert/$id');
      return PerformanceAlert.fromJson(r.data['data']);
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Get all ──
  Future<List<PerformanceAlert>> getAll({
    int page = 1, int limit = 20,
    Map<String, dynamic>? filters,
  }) async {
    try {
      final q = <String, dynamic>{'page': page.toString(), 'limit': limit.toString()};
      if (filters != null) q.addAll(filters);
      final r = await _dioClient.get('/performanceAlert', queryParameters: q);
      return (r.data['data'] as List).map((j) => PerformanceAlert.fromJson(j)).toList();
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Get with filters ──
  Future<List<PerformanceAlert>> getWithFilters({
    String? alertType,
    String? severity,
    String? metricName,
    double? threshold,
    double? actualValue,
  }) async {
    final filters = <String, dynamic>{};
    if (alertType != null) filters['alertType'] = alertType;
    if (severity != null) filters['severity'] = severity;
    if (metricName != null) filters['metricName'] = metricName;
    if (threshold != null) filters['threshold'] = threshold.toString();
    if (actualValue != null) filters['actualValue'] = actualValue.toString();
    return getAll(filters: filters);
  }

  // ── Create ──
  Future<PerformanceAlert> create(PerformanceAlert performanceAlert) async {

    try {
      final r = await _dioClient.post('/performanceAlert', data: performanceAlert.toJson());
      return PerformanceAlert.fromJson(r.data['data']);
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Update ──
  Future<PerformanceAlert> update(String id, PerformanceAlert performanceAlert) async {
    if (id.isEmpty) throw ArgumentError('ID cannot be empty');
    try {
      final r = await _dioClient.put('/performanceAlert/$id', data: performanceAlert.toJson());
      return PerformanceAlert.fromJson(r.data['data']);
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Delete ──
  Future<void> delete(String id) async {
    if (id.isEmpty) throw ArgumentError('ID cannot be empty');
    try {
      await _dioClient.delete('/performanceAlert/$id');
    } on DioException catch (e) { throw _err(e); }
  }

  Exception _err(DioException e) {
    switch (e.type) {
      case DioExceptionType.connectionTimeout:
        return Exception('Connection timeout. Check your internet connection.');
      case DioExceptionType.badResponse:
        final msg = e.response?.data?['message'] ?? 'Server error';
        return Exception('Server error: $msg');
      case DioExceptionType.connectionError:
        return Exception('Network error. Check your internet connection.');
      default:
        return Exception('Request failed: ${e.message}');
    }
  }
}