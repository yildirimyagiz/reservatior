import 'package:dio/dio.dart';
import '../../../core/network/dio_client.dart';
import '../../gen_models/models_library.dart';

class CommissionService {
  final DioClient _dioClient;
  CommissionService(this._dioClient);

  // ── Get by ID ──
  Future<Commission> getById(String id) async {
    if (id.isEmpty) throw ArgumentError('ID cannot be empty');
    try {
      final r = await _dioClient.get('/commission/$id');
      return Commission.fromJson(r.data['data']);
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Get all ──
  Future<List<Commission>> getAll({
    int page = 1, int limit = 20,
    Map<String, dynamic>? filters,
  }) async {
    try {
      final q = <String, dynamic>{'page': page.toString(), 'limit': limit.toString()};
      if (filters != null) q.addAll(filters);
      final r = await _dioClient.get('/commission', queryParameters: q);
      return (r.data['data'] as List).map((j) => Commission.fromJson(j)).toList();
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Get with filters ──
  Future<List<Commission>> getWithFilters({
    dynamic? ruleData,
    double? amountBase,
    double? commissionAmount,
    String? currency,
    dynamic? records,
  }) async {
    final filters = <String, dynamic>{};
    if (ruleData != null) filters['ruleData'] = ruleData.toString();
    if (amountBase != null) filters['amountBase'] = amountBase.toString();
    if (commissionAmount != null) filters['commissionAmount'] = commissionAmount.toString();
    if (currency != null) filters['currency'] = currency;
    if (records != null) filters['records'] = records.toString();
    return getAll(filters: filters);
  }

  // ── Create ──
  Future<Commission> create(Commission commission) async {

    try {
      final r = await _dioClient.post('/commission', data: commission.toJson());
      return Commission.fromJson(r.data['data']);
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Update ──
  Future<Commission> update(String id, Commission commission) async {
    if (id.isEmpty) throw ArgumentError('ID cannot be empty');
    try {
      final r = await _dioClient.put('/commission/$id', data: commission.toJson());
      return Commission.fromJson(r.data['data']);
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Delete ──
  Future<void> delete(String id) async {
    if (id.isEmpty) throw ArgumentError('ID cannot be empty');
    try {
      await _dioClient.delete('/commission/$id');
    } on DioException catch (e) { throw _err(e); }
  }

  Exception _err(DioException e) {
    switch (e.type) {
      case DioExceptionType.connectionTimeout:
        return Exception('Connection timeout. Check your internet connection.');
      case DioExceptionType.badResponse:
        final msg = e.response?.data?['message'] ?? 'Server error';
        return Exception('Server error: $msg');
      case DioExceptionType.connectionError:
        return Exception('Network error. Check your internet connection.');
      default:
        return Exception('Request failed: ${e.message}');
    }
  }
}