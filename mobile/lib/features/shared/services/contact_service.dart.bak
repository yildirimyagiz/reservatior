import 'package:dio/dio.dart';
import '../../../core/network/dio_client.dart';
import '../../gen_models/models_library.dart';

class ContactService {
  final DioClient _dioClient;
  ContactService(this._dioClient);

  // ── Get by ID ──
  Future<Contact> getById(String id) async {
    if (id.isEmpty) throw ArgumentError('ID cannot be empty');
    try {
      final r = await _dioClient.get('/contact/$id');
      return Contact.fromJson(r.data['data']);
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Get all ──
  Future<List<Contact>> getAll({
    int page = 1, int limit = 20,
    Map<String, dynamic>? filters,
  }) async {
    try {
      final q = <String, dynamic>{'page': page.toString(), 'limit': limit.toString()};
      if (filters != null) q.addAll(filters);
      final r = await _dioClient.get('/contact', queryParameters: q);
      return (r.data['data'] as List).map((j) => Contact.fromJson(j)).toList();
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Get with filters ──
  Future<List<Contact>> getWithFilters({
    ContactType? type,
    String? fullName,
    String? email,
    String? phone,
    String? notes,
  }) async {
    final filters = <String, dynamic>{};
    if (type != null) filters['type'] = type.toString();
    if (fullName != null) filters['fullName'] = fullName;
    if (email != null) filters['email'] = email;
    if (phone != null) filters['phone'] = phone;
    if (notes != null) filters['notes'] = notes;
    return getAll(filters: filters);
  }

  // ── Create ──
  Future<Contact> create(Contact contact) async {
    if (contact.type == null || contact.type!.isEmpty) {
      throw ArgumentError('type is required');
    }
    if (contact.email == null || contact.email!.isEmpty) {
      throw ArgumentError('email is required');
    }
    try {
      final r = await _dioClient.post('/contact', data: contact.toJson());
      return Contact.fromJson(r.data['data']);
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Update ──
  Future<Contact> update(String id, Contact contact) async {
    if (id.isEmpty) throw ArgumentError('ID cannot be empty');
    try {
      final r = await _dioClient.put('/contact/$id', data: contact.toJson());
      return Contact.fromJson(r.data['data']);
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Delete ──
  Future<void> delete(String id) async {
    if (id.isEmpty) throw ArgumentError('ID cannot be empty');
    try {
      await _dioClient.delete('/contact/$id');
    } on DioException catch (e) { throw _err(e); }
  }

  Exception _err(DioException e) {
    switch (e.type) {
      case DioExceptionType.connectionTimeout:
        return Exception('Connection timeout. Check your internet connection.');
      case DioExceptionType.badResponse:
        final msg = e.response?.data?['message'] ?? 'Server error';
        return Exception('Server error: $msg');
      case DioExceptionType.connectionError:
        return Exception('Network error. Check your internet connection.');
      default:
        return Exception('Request failed: ${e.message}');
    }
  }
}