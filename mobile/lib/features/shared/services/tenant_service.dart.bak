import 'package:dio/dio.dart';
import '../../../core/network/dio_client.dart';
import '../../gen_models/models_library.dart';

class TenantService {
  final DioClient _dioClient;
  TenantService(this._dioClient);

  // ── Get by ID ──
  Future<Tenant> getById(String id) async {
    if (id.isEmpty) throw ArgumentError('ID cannot be empty');
    try {
      final r = await _dioClient.get('/tenant/$id');
      return Tenant.fromJson(r.data['data']);
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Get all ──
  Future<List<Tenant>> getAll({
    int page = 1, int limit = 20,
    Map<String, dynamic>? filters,
  }) async {
    try {
      final q = <String, dynamic>{'page': page.toString(), 'limit': limit.toString()};
      if (filters != null) q.addAll(filters);
      final r = await _dioClient.get('/tenant', queryParameters: q);
      return (r.data['data'] as List).map((j) => Tenant.fromJson(j)).toList();
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Get with filters ──
  Future<List<Tenant>> getWithFilters({
    String? firstName,
    String? lastName,
    String? email,
    String? phoneNumber,
    DateTime? leaseStartDate,
  }) async {
    final filters = <String, dynamic>{};
    if (firstName != null) filters['firstName'] = firstName;
    if (lastName != null) filters['lastName'] = lastName;
    if (email != null) filters['email'] = email;
    if (phoneNumber != null) filters['phoneNumber'] = phoneNumber;
    if (leaseStartDate != null) filters['leaseStartDate'] = leaseStartDate.toIso8601String();
    return getAll(filters: filters);
  }

  // ── Create ──
  Future<Tenant> create(Tenant tenant) async {
    if (tenant.email == null || tenant.email!.isEmpty) {
      throw ArgumentError('email is required');
    }
    try {
      final r = await _dioClient.post('/tenant', data: tenant.toJson());
      return Tenant.fromJson(r.data['data']);
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Update ──
  Future<Tenant> update(String id, Tenant tenant) async {
    if (id.isEmpty) throw ArgumentError('ID cannot be empty');
    try {
      final r = await _dioClient.put('/tenant/$id', data: tenant.toJson());
      return Tenant.fromJson(r.data['data']);
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Delete ──
  Future<void> delete(String id) async {
    if (id.isEmpty) throw ArgumentError('ID cannot be empty');
    try {
      await _dioClient.delete('/tenant/$id');
    } on DioException catch (e) { throw _err(e); }
  }

  Exception _err(DioException e) {
    switch (e.type) {
      case DioExceptionType.connectionTimeout:
        return Exception('Connection timeout. Check your internet connection.');
      case DioExceptionType.badResponse:
        final msg = e.response?.data?['message'] ?? 'Server error';
        return Exception('Server error: $msg');
      case DioExceptionType.connectionError:
        return Exception('Network error. Check your internet connection.');
      default:
        return Exception('Request failed: ${e.message}');
    }
  }
}