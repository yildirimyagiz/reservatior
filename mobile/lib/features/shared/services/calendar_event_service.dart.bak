import 'package:dio/dio.dart';
import '../../../core/network/dio_client.dart';
import '../../gen_models/models_library.dart';

class CalendarEventService {
  final DioClient _dioClient;
  CalendarEventService(this._dioClient);

  // ── Get by ID ──
  Future<CalendarEvent> getById(String id) async {
    if (id.isEmpty) throw ArgumentError('ID cannot be empty');
    try {
      final r = await _dioClient.get('/calendarEvent/$id');
      return CalendarEvent.fromJson(r.data['data']);
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Get all ──
  Future<List<CalendarEvent>> getAll({
    int page = 1, int limit = 20,
    Map<String, dynamic>? filters,
  }) async {
    try {
      final q = <String, dynamic>{'page': page.toString(), 'limit': limit.toString()};
      if (filters != null) q.addAll(filters);
      final r = await _dioClient.get('/calendarEvent', queryParameters: q);
      return (r.data['data'] as List).map((j) => CalendarEvent.fromJson(j)).toList();
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Get with filters ──
  Future<List<CalendarEvent>> getWithFilters({
    String? externalSource,
    String? title,
    String? description,
    DateTime? startDate,
    DateTime? endDate,
  }) async {
    final filters = <String, dynamic>{};
    if (externalSource != null) filters['externalSource'] = externalSource;
    if (title != null) filters['title'] = title;
    if (description != null) filters['description'] = description;
    if (startDate != null) filters['startDate'] = startDate.toIso8601String();
    if (endDate != null) filters['endDate'] = endDate.toIso8601String();
    return getAll(filters: filters);
  }

  // ── Create ──
  Future<CalendarEvent> create(CalendarEvent calendarEvent) async {
    if (calendarEvent.title == null || calendarEvent.title!.isEmpty) {
      throw ArgumentError('title is required');
    }
    try {
      final r = await _dioClient.post('/calendarEvent', data: calendarEvent.toJson());
      return CalendarEvent.fromJson(r.data['data']);
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Update ──
  Future<CalendarEvent> update(String id, CalendarEvent calendarEvent) async {
    if (id.isEmpty) throw ArgumentError('ID cannot be empty');
    try {
      final r = await _dioClient.put('/calendarEvent/$id', data: calendarEvent.toJson());
      return CalendarEvent.fromJson(r.data['data']);
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Delete ──
  Future<void> delete(String id) async {
    if (id.isEmpty) throw ArgumentError('ID cannot be empty');
    try {
      await _dioClient.delete('/calendarEvent/$id');
    } on DioException catch (e) { throw _err(e); }
  }

  Exception _err(DioException e) {
    switch (e.type) {
      case DioExceptionType.connectionTimeout:
        return Exception('Connection timeout. Check your internet connection.');
      case DioExceptionType.badResponse:
        final msg = e.response?.data?['message'] ?? 'Server error';
        return Exception('Server error: $msg');
      case DioExceptionType.connectionError:
        return Exception('Network error. Check your internet connection.');
      default:
        return Exception('Request failed: ${e.message}');
    }
  }
}