import 'package:dio/dio.dart';
import '../../../core/network/dio_client.dart';
import '../../gen_models/models_library.dart';

class AccountService {
  final DioClient _dioClient;
  AccountService(this._dioClient);

  // ── Get by ID ──
  Future<Account> getById(String id) async {
    if (id.isEmpty) throw ArgumentError('ID cannot be empty');
    try {
      final r = await _dioClient.get('/account/$id');
      return Account.fromJson(r.data['data']);
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Get all ──
  Future<List<Account>> getAll({
    int page = 1, int limit = 20,
    Map<String, dynamic>? filters,
  }) async {
    try {
      final q = <String, dynamic>{'page': page.toString(), 'limit': limit.toString()};
      if (filters != null) q.addAll(filters);
      final r = await _dioClient.get('/account', queryParameters: q);
      return (r.data['data'] as List).map((j) => Account.fromJson(j)).toList();
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Get with filters ──
  Future<List<Account>> getWithFilters({
    AccountType? type,
    String? refreshToken,
    String? accessToken,
    DateTime? accessTokenExpiresAt,
    String? tokenType,
  }) async {
    final filters = <String, dynamic>{};
    if (type != null) filters['type'] = type.toString();
    if (refreshToken != null) filters['refreshToken'] = refreshToken;
    if (accessToken != null) filters['accessToken'] = accessToken;
    if (accessTokenExpiresAt != null) filters['accessTokenExpiresAt'] = accessTokenExpiresAt.toIso8601String();
    if (tokenType != null) filters['tokenType'] = tokenType;
    return getAll(filters: filters);
  }

  // ── Create ──
  Future<Account> create(Account account) async {
    if (account.type == null || account.type!.isEmpty) {
      throw ArgumentError('type is required');
    }
    try {
      final r = await _dioClient.post('/account', data: account.toJson());
      return Account.fromJson(r.data['data']);
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Update ──
  Future<Account> update(String id, Account account) async {
    if (id.isEmpty) throw ArgumentError('ID cannot be empty');
    try {
      final r = await _dioClient.put('/account/$id', data: account.toJson());
      return Account.fromJson(r.data['data']);
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Delete ──
  Future<void> delete(String id) async {
    if (id.isEmpty) throw ArgumentError('ID cannot be empty');
    try {
      await _dioClient.delete('/account/$id');
    } on DioException catch (e) { throw _err(e); }
  }

  Exception _err(DioException e) {
    switch (e.type) {
      case DioExceptionType.connectionTimeout:
        return Exception('Connection timeout. Check your internet connection.');
      case DioExceptionType.badResponse:
        final msg = e.response?.data?['message'] ?? 'Server error';
        return Exception('Server error: $msg');
      case DioExceptionType.connectionError:
        return Exception('Network error. Check your internet connection.');
      default:
        return Exception('Request failed: ${e.message}');
    }
  }
}