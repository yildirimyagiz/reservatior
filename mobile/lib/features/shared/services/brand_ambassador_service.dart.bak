import 'package:dio/dio.dart';
import '../../../core/network/dio_client.dart';
import '../../gen_models/models_library.dart';

class BrandAmbassadorService {
  final DioClient _dioClient;
  BrandAmbassadorService(this._dioClient);

  // ── Get by ID ──
  Future<BrandAmbassador> getById(String id) async {
    if (id.isEmpty) throw ArgumentError('ID cannot be empty');
    try {
      final r = await _dioClient.get('/brandAmbassador/$id');
      return BrandAmbassador.fromJson(r.data['data']);
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Get all ──
  Future<List<BrandAmbassador>> getAll({
    int page = 1, int limit = 20,
    Map<String, dynamic>? filters,
  }) async {
    try {
      final q = <String, dynamic>{'page': page.toString(), 'limit': limit.toString()};
      if (filters != null) q.addAll(filters);
      final r = await _dioClient.get('/brandAmbassador', queryParameters: q);
      return (r.data['data'] as List).map((j) => BrandAmbassador.fromJson(j)).toList();
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Get with filters ──
  Future<List<BrandAmbassador>> getWithFilters({
    String? fullName,
    String? emailCiphertext,
    String? phoneCiphertext,
    AmbassadorCategory? category,
    int? followerCount,
  }) async {
    final filters = <String, dynamic>{};
    if (fullName != null) filters['fullName'] = fullName;
    if (emailCiphertext != null) filters['emailCiphertext'] = emailCiphertext;
    if (phoneCiphertext != null) filters['phoneCiphertext'] = phoneCiphertext;
    if (category != null) filters['category'] = category.toString();
    if (followerCount != null) filters['followerCount'] = followerCount.toString();
    return getAll(filters: filters);
  }

  // ── Create ──
  Future<BrandAmbassador> create(BrandAmbassador brandAmbassador) async {

    try {
      final r = await _dioClient.post('/brandAmbassador', data: brandAmbassador.toJson());
      return BrandAmbassador.fromJson(r.data['data']);
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Update ──
  Future<BrandAmbassador> update(String id, BrandAmbassador brandAmbassador) async {
    if (id.isEmpty) throw ArgumentError('ID cannot be empty');
    try {
      final r = await _dioClient.put('/brandAmbassador/$id', data: brandAmbassador.toJson());
      return BrandAmbassador.fromJson(r.data['data']);
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Delete ──
  Future<void> delete(String id) async {
    if (id.isEmpty) throw ArgumentError('ID cannot be empty');
    try {
      await _dioClient.delete('/brandAmbassador/$id');
    } on DioException catch (e) { throw _err(e); }
  }

  Exception _err(DioException e) {
    switch (e.type) {
      case DioExceptionType.connectionTimeout:
        return Exception('Connection timeout. Check your internet connection.');
      case DioExceptionType.badResponse:
        final msg = e.response?.data?['message'] ?? 'Server error';
        return Exception('Server error: $msg');
      case DioExceptionType.connectionError:
        return Exception('Network error. Check your internet connection.');
      default:
        return Exception('Request failed: ${e.message}');
    }
  }
}