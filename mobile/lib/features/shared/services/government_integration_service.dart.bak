import 'package:dio/dio.dart';
import '../../../core/network/dio_client.dart';
import '../../gen_models/models_library.dart';

class GovernmentIntegrationService {
  final DioClient _dioClient;
  GovernmentIntegrationService(this._dioClient);

  // ── Get by ID ──
  Future<GovernmentIntegration> getById(String id) async {
    if (id.isEmpty) throw ArgumentError('ID cannot be empty');
    try {
      final r = await _dioClient.get('/governmentIntegration/$id');
      return GovernmentIntegration.fromJson(r.data['data']);
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Get all ──
  Future<List<GovernmentIntegration>> getAll({
    int page = 1, int limit = 20,
    Map<String, dynamic>? filters,
  }) async {
    try {
      final q = <String, dynamic>{'page': page.toString(), 'limit': limit.toString()};
      if (filters != null) q.addAll(filters);
      final r = await _dioClient.get('/governmentIntegration', queryParameters: q);
      return (r.data['data'] as List).map((j) => GovernmentIntegration.fromJson(j)).toList();
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Get with filters ──
  Future<List<GovernmentIntegration>> getWithFilters({
    Region? region,
    String? name,
    String? baseUrl,
    bool? isEnabled,
    String? apiKeyCiphertext,
  }) async {
    final filters = <String, dynamic>{};
    if (region != null) filters['region'] = region.toString();
    if (name != null) filters['name'] = name;
    if (baseUrl != null) filters['baseUrl'] = baseUrl;
    if (isEnabled != null) filters['isEnabled'] = isEnabled.toString();
    if (apiKeyCiphertext != null) filters['apiKeyCiphertext'] = apiKeyCiphertext;
    return getAll(filters: filters);
  }

  // ── Create ──
  Future<GovernmentIntegration> create(GovernmentIntegration governmentIntegration) async {
    if (governmentIntegration.name == null || governmentIntegration.name!.isEmpty) {
      throw ArgumentError('name is required');
    }
    try {
      final r = await _dioClient.post('/governmentIntegration', data: governmentIntegration.toJson());
      return GovernmentIntegration.fromJson(r.data['data']);
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Update ──
  Future<GovernmentIntegration> update(String id, GovernmentIntegration governmentIntegration) async {
    if (id.isEmpty) throw ArgumentError('ID cannot be empty');
    try {
      final r = await _dioClient.put('/governmentIntegration/$id', data: governmentIntegration.toJson());
      return GovernmentIntegration.fromJson(r.data['data']);
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Delete ──
  Future<void> delete(String id) async {
    if (id.isEmpty) throw ArgumentError('ID cannot be empty');
    try {
      await _dioClient.delete('/governmentIntegration/$id');
    } on DioException catch (e) { throw _err(e); }
  }

  Exception _err(DioException e) {
    switch (e.type) {
      case DioExceptionType.connectionTimeout:
        return Exception('Connection timeout. Check your internet connection.');
      case DioExceptionType.badResponse:
        final msg = e.response?.data?['message'] ?? 'Server error';
        return Exception('Server error: $msg');
      case DioExceptionType.connectionError:
        return Exception('Network error. Check your internet connection.');
      default:
        return Exception('Request failed: ${e.message}');
    }
  }
}