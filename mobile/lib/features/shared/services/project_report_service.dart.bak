import 'package:dio/dio.dart';
import '../../../core/network/dio_client.dart';
import '../../gen_models/models_library.dart';

class ProjectReportService {
  final DioClient _dioClient;
  ProjectReportService(this._dioClient);

  // ── Get by ID ──
  Future<ProjectReport> getById(String id) async {
    if (id.isEmpty) throw ArgumentError('ID cannot be empty');
    try {
      final r = await _dioClient.get('/projectReport/$id');
      return ProjectReport.fromJson(r.data['data']);
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Get all ──
  Future<List<ProjectReport>> getAll({
    int page = 1, int limit = 20,
    Map<String, dynamic>? filters,
  }) async {
    try {
      final q = <String, dynamic>{'page': page.toString(), 'limit': limit.toString()};
      if (filters != null) q.addAll(filters);
      final r = await _dioClient.get('/projectReport', queryParameters: q);
      return (r.data['data'] as List).map((j) => ProjectReport.fromJson(j)).toList();
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Get with filters ──
  Future<List<ProjectReport>> getWithFilters({
    String? reportType,
    String? title,
    String? content,
    dynamic? data,
    String? generatedBy,
  }) async {
    final filters = <String, dynamic>{};
    if (reportType != null) filters['reportType'] = reportType;
    if (title != null) filters['title'] = title;
    if (content != null) filters['content'] = content;
    if (data != null) filters['data'] = data.toString();
    if (generatedBy != null) filters['generatedBy'] = generatedBy;
    return getAll(filters: filters);
  }

  // ── Create ──
  Future<ProjectReport> create(ProjectReport projectReport) async {
    if (projectReport.title == null || projectReport.title!.isEmpty) {
      throw ArgumentError('title is required');
    }
    try {
      final r = await _dioClient.post('/projectReport', data: projectReport.toJson());
      return ProjectReport.fromJson(r.data['data']);
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Update ──
  Future<ProjectReport> update(String id, ProjectReport projectReport) async {
    if (id.isEmpty) throw ArgumentError('ID cannot be empty');
    try {
      final r = await _dioClient.put('/projectReport/$id', data: projectReport.toJson());
      return ProjectReport.fromJson(r.data['data']);
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Delete ──
  Future<void> delete(String id) async {
    if (id.isEmpty) throw ArgumentError('ID cannot be empty');
    try {
      await _dioClient.delete('/projectReport/$id');
    } on DioException catch (e) { throw _err(e); }
  }

  Exception _err(DioException e) {
    switch (e.type) {
      case DioExceptionType.connectionTimeout:
        return Exception('Connection timeout. Check your internet connection.');
      case DioExceptionType.badResponse:
        final msg = e.response?.data?['message'] ?? 'Server error';
        return Exception('Server error: $msg');
      case DioExceptionType.connectionError:
        return Exception('Network error. Check your internet connection.');
      default:
        return Exception('Request failed: ${e.message}');
    }
  }
}