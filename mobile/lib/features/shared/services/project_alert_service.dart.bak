import 'package:dio/dio.dart';
import '../../../core/network/dio_client.dart';
import '../../gen_models/models_library.dart';

class ProjectAlertService {
  final DioClient _dioClient;
  ProjectAlertService(this._dioClient);

  // ── Get by ID ──
  Future<ProjectAlert> getById(String id) async {
    if (id.isEmpty) throw ArgumentError('ID cannot be empty');
    try {
      final r = await _dioClient.get('/projectAlert/$id');
      return ProjectAlert.fromJson(r.data['data']);
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Get all ──
  Future<List<ProjectAlert>> getAll({
    int page = 1, int limit = 20,
    Map<String, dynamic>? filters,
  }) async {
    try {
      final q = <String, dynamic>{'page': page.toString(), 'limit': limit.toString()};
      if (filters != null) q.addAll(filters);
      final r = await _dioClient.get('/projectAlert', queryParameters: q);
      return (r.data['data'] as List).map((j) => ProjectAlert.fromJson(j)).toList();
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Get with filters ──
  Future<List<ProjectAlert>> getWithFilters({
    String? alertType,
    String? title,
    String? message,
    String? severity,
    bool? isRead,
  }) async {
    final filters = <String, dynamic>{};
    if (alertType != null) filters['alertType'] = alertType;
    if (title != null) filters['title'] = title;
    if (message != null) filters['message'] = message;
    if (severity != null) filters['severity'] = severity;
    if (isRead != null) filters['isRead'] = isRead.toString();
    return getAll(filters: filters);
  }

  // ── Create ──
  Future<ProjectAlert> create(ProjectAlert projectAlert) async {
    if (projectAlert.title == null || projectAlert.title!.isEmpty) {
      throw ArgumentError('title is required');
    }
    try {
      final r = await _dioClient.post('/projectAlert', data: projectAlert.toJson());
      return ProjectAlert.fromJson(r.data['data']);
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Update ──
  Future<ProjectAlert> update(String id, ProjectAlert projectAlert) async {
    if (id.isEmpty) throw ArgumentError('ID cannot be empty');
    try {
      final r = await _dioClient.put('/projectAlert/$id', data: projectAlert.toJson());
      return ProjectAlert.fromJson(r.data['data']);
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Delete ──
  Future<void> delete(String id) async {
    if (id.isEmpty) throw ArgumentError('ID cannot be empty');
    try {
      await _dioClient.delete('/projectAlert/$id');
    } on DioException catch (e) { throw _err(e); }
  }

  Exception _err(DioException e) {
    switch (e.type) {
      case DioExceptionType.connectionTimeout:
        return Exception('Connection timeout. Check your internet connection.');
      case DioExceptionType.badResponse:
        final msg = e.response?.data?['message'] ?? 'Server error';
        return Exception('Server error: $msg');
      case DioExceptionType.connectionError:
        return Exception('Network error. Check your internet connection.');
      default:
        return Exception('Request failed: ${e.message}');
    }
  }
}