import 'package:dio/dio.dart';
import '../../../core/network/dio_client.dart';
import '../../gen_models/models_library.dart';

class ExternalRentalListingService {
  final DioClient _dioClient;
  ExternalRentalListingService(this._dioClient);

  // ── Get by ID ──
  Future<ExternalRentalListing> getById(String id) async {
    if (id.isEmpty) throw ArgumentError('ID cannot be empty');
    try {
      final r = await _dioClient.get('/externalRentalListing/$id');
      return ExternalRentalListing.fromJson(r.data['data']);
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Get all ──
  Future<List<ExternalRentalListing>> getAll({
    int page = 1, int limit = 20,
    Map<String, dynamic>? filters,
  }) async {
    try {
      final q = <String, dynamic>{'page': page.toString(), 'limit': limit.toString()};
      if (filters != null) q.addAll(filters);
      final r = await _dioClient.get('/externalRentalListing', queryParameters: q);
      return (r.data['data'] as List).map((j) => ExternalRentalListing.fromJson(j)).toList();
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Get with filters ──
  Future<List<ExternalRentalListing>> getWithFilters({
    RentalPlatform? platform,
    String? externalUrl,
    String? title,
    String? description,
    RentalStatus? status,
  }) async {
    final filters = <String, dynamic>{};
    if (platform != null) filters['platform'] = platform.toString();
    if (externalUrl != null) filters['externalUrl'] = externalUrl;
    if (title != null) filters['title'] = title;
    if (description != null) filters['description'] = description;
    if (status != null) filters['status'] = status.toString();
    return getAll(filters: filters);
  }

  // ── Create ──
  Future<ExternalRentalListing> create(ExternalRentalListing externalRentalListing) async {
    if (externalRentalListing.title == null || externalRentalListing.title!.isEmpty) {
      throw ArgumentError('title is required');
    }
    try {
      final r = await _dioClient.post('/externalRentalListing', data: externalRentalListing.toJson());
      return ExternalRentalListing.fromJson(r.data['data']);
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Update ──
  Future<ExternalRentalListing> update(String id, ExternalRentalListing externalRentalListing) async {
    if (id.isEmpty) throw ArgumentError('ID cannot be empty');
    try {
      final r = await _dioClient.put('/externalRentalListing/$id', data: externalRentalListing.toJson());
      return ExternalRentalListing.fromJson(r.data['data']);
    } on DioException catch (e) { throw _err(e); }
  }

  // ── Delete ──
  Future<void> delete(String id) async {
    if (id.isEmpty) throw ArgumentError('ID cannot be empty');
    try {
      await _dioClient.delete('/externalRentalListing/$id');
    } on DioException catch (e) { throw _err(e); }
  }

  Exception _err(DioException e) {
    switch (e.type) {
      case DioExceptionType.connectionTimeout:
        return Exception('Connection timeout. Check your internet connection.');
      case DioExceptionType.badResponse:
        final msg = e.response?.data?['message'] ?? 'Server error';
        return Exception('Server error: $msg');
      case DioExceptionType.connectionError:
        return Exception('Network error. Check your internet connection.');
      default:
        return Exception('Request failed: ${e.message}');
    }
  }
}