# API Configuration
API_BASE_URL=http://localhost:3005

# Environment
FLUTTER_ENV=development

# Copy this file to .env and update the values as needed
# For different server ports, change API_BASE_URL accordingly:
# - Port 3000: API_BASE_URL=http://localhost:3000
# - Port 3001: API_BASE_URL=http://localhost:3001
# - Port 3005: API_BASE_URL=http://localhost:3005
# - Production: API_BASE_URL=https://your-production-domain.com
